# Whisper-Input-Next 配置模板：复制为 .env 后填写

# ===== 转录服务 =====
# Ctrl+F 用哪个服务：doubao（默认，边说边转）或 openai（录完整段再转）
TRANSCRIPTION_SERVICE=doubao

# 豆包流式语音识别（火山引擎控制台的 APP ID 和 Access Token，获取方法见 README）
DOUBAO_APP_KEY=your_app_id_here
DOUBAO_ACCESS_KEY=your_access_token_here

# OpenAI gpt-4o-transcribe（豆包不可用时的备用，和豆包至少配置一个）
OFFICIAL_OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# 把 OpenAI 结果里的繁体转成简体
CONVERT_TO_SIMPLIFIED=false
# OpenAI 转录失败时自动重试的次数
AUTO_RETRY_LIMIT=5

# ===== 本地 whisper.cpp（Ctrl+I，可选，不配就禁用）=====
WHISPER_CLI_PATH=/path/to/whisper.cpp/build/bin/whisper-cli
# 模型路径，可以是绝对路径，也可以相对 whisper.cpp 根目录
WHISPER_MODEL_PATH=models/ggml-large-v3.bin

# ===== 热键 =====
# 修饰键 + 转录键 开始/结束录音，修饰键 + i 用本地 Whisper。默认 Ctrl+F / Ctrl+I
HOTKEY_MODIFIER=ctrl
TRANSCRIPTIONS_BUTTON=f
# 粘贴文本用的系统：mac（Cmd+V）或 win（Ctrl+V）
SYSTEM_PLATFORM=mac

# ===== 状态栏图标（可选）=====
# 默认用 assets/icons/ 下的 idle.png、recording.png、transcripting.png
# STATUS_ICON_IDLE=/path/to/idle.png
# STATUS_ICON_RECORDING=/path/to/recording.png
# STATUS_ICON_PROCESSING=/path/to/processing.png
# STATUS_ICON_TEMPLATE=true
